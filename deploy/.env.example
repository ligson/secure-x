SECUREX_IMAGE=ligson/securex-be:v1.0.31
LIVEKIT_IMAGE=livekit/livekit-server:latest

# Local HTTP ports. Keep these bound to 127.0.0.1 and expose them through HTTPS reverse proxy.
SECUREX_HTTP_HOST=127.0.0.1
SECUREX_HTTP_PORT=8080
SECUREX_CONTAINER_HTTP_PORT=8080
SECUREX_CONTAINER_USER=10001:10001
LIVEKIT_HTTP_HOST=127.0.0.1
LIVEKIT_HTTP_PORT=7880

# Public UDP ports for LiveKit media/TURN.
LIVEKIT_TURN_HOST=0.0.0.0
LIVEKIT_TURN_PORT=5349
LIVEKIT_RTC_HOST=0.0.0.0
LIVEKIT_RTC_PORT_START=50000
LIVEKIT_RTC_PORT_END=50010
LIVEKIT_CERTS_DIR=./livekit/certs
PROXY_NETWORK=mynetwork
